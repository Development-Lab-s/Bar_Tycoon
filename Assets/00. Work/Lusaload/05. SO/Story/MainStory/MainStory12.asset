  title: "\uC14B\uC774\uC11C."
  skipSummary: "\uC720\uB77C\uAC00 \uAC00\uBCBC\uC6B4 \uC9C8\uBB38\uC744 \uB358\uC9C4
    \uAC83\uC5D0 \uB9B0\uC774 \uAC00\uC871 \uC774\uC57C\uAE30\uB97C \uC0B4\uC9DD
    \uD758\uB9AC\uACE0, \uC720\uB77C\uB3C4 \uC790\uAE30 \uC774\uC57C\uAE30\uB97C
    \uD55C \uC790\uB77D \uAEBC\uB0B8\uB2E4. \uADF8 \uC21C\uAC04 \uB9C8\uAC10 \uC9C1\uC804\uC5D0
