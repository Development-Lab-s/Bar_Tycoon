  m_Script: {fileID: 11500000, guid: 213ce22313033f64e83377bd5902ea1f, type: 3}
  m_Name: Rin
  m_EditorClassIdentifier: Assembly-CSharp::CharacterSO
  id: Cian
  characterName: Cian
  currentLevel: 1
  currentExp: 0
  maxLevel: 10
  characterPortrait: {fileID: 0}
  dialogueGroups:
  - unlockLevel: 1
    dialogues:
    - context: "\uC800 \uC798 \uD558\uAC70\uB4E0\uC694? \uBF51\uC73C\uC2E0 \uAC70
        \uD6C4\uD68C \uC548 \uD558\uC2E4 \uAC70\uC608\uC694."
    - context: "\uC810\uC7A5\uB2D8\uB3C4 \uC0DD\uAC01\uBCF4\uB2E4 \uAD1C\uCC2E\uC740
        \uC0AC\uB78C \uAC19\uB124\uC694. \uCE6D\uCC2C\uC774\uC5D0\uC694."
    - context: "\uC77C\uB2E8 \uC2DC\uC791\uD574 \uBCF4\uC8E0, \uBB50."
  - unlockLevel: 2
    dialogues:
    - context: "\uC9C0\uAE08 \uC81C\uAC00 \uC794 \uAE7C\uB294\uB370\uC694. \uC6D0\uB798
        \uC774\uB7F0 \uC0AC\uB78C \uC544\uB2C8\uAC70\uB4E0\uC694, \uC9C4\uC9DC\uB85C."
    - context: "\uB808\uC2DC\uD53C \uC678\uC6E0\uC5B4\uC694. \uAC70\uC758 \uB2E4\uC694.
        \uD55C \uB450 \uAC1C \uBE7C\uACE0."
    - context: "\uC65C \uC6C3\uC5B4\uC694. \uC800 \uC798 \uD558\uACE0 \uC788\uAC70\uB4E0\uC694."
  - unlockLevel: 4
    dialogues:
    - context: "\uC624\uB298 \uC190\uB2D8\uC774 \uB9DB\uC788\uB2E4\uACE0 \uD588\uAC70\uB4E0\uC694.
        \uC800\uD55C\uD14C\uC694. \uB4E4\uC5C8\uC5B4\uC694?"
    - context: "\uC810\uC7A5\uB2D8\uC740 \uC798 \uD55C\uB2E4\uB294 \uB9D0 \uC798
        \uC548 \uD558\uC8E0. \uADF8\uAC70 \uC77C\uBD80\uB7EC \uADF8\uB7EC\uB294 \uAC70\uC608\uC694?"
    - context: "\uCE6D\uCC2C \uD55C \uBC88\uB9CC \uD574\uC918\uC694. \uADF8\uAC70
        \uC5B4\uB824\uC6CC\uC694?"
  - unlockLevel: 6
    dialogues:
    - context: "\uC800 \uC0AC\uC2E4 \uBC14\uD150\uB354 \uB41C \uAC70, \uC774\uC720\uAC00
        \uC788\uAC70\uB4E0\uC694. \uBB50, \uB098\uC911\uC5D0 \uB9D0\uD560 \uC218\uB3C4
        \uC788\uC5B4\uC694."
    - context: "\uC810\uC7A5\uB2D8\uC740 \uC774\uC0C1\uD558\uAC8C \uD654\uB97C \uC548
        \uB0B4\uC694. \uADF8\uAC8C \uB354 \uC2E0\uACBD \uC4F0\uC5EC\uC694."
    - context: "\uC800 \uAC89\uC774\uB791 \uC18D\uC774 \uB2E4\uB978 \uC0AC\uB78C
        \uC544\uB2C8\uAC70\uB4E0\uC694. ...\uC870\uAE08\uC740 \uB2EC\uB77C\uC694.
        \uC870\uAE08\uB9CC\uC694."
  - unlockLevel: 8
    dialogues:
    - context: "\uB3D9\uC0DD\uC774 \uC788\uC5B4\uC694. \uBC14\uD150\uB354 \uB418\uACE0
        \uC2F6\uB2E4\uACE0 \uD588\uC5C8\uAC70\uB4E0\uC694. ...\uB410\uACE0, \uADF8\uB0E5
        \uADF8\uB798\uC694."
    - context: "\uC81C\uAC00 \uC774 \uAE38 \uAC00\uB294 \uAC70, \uBC18\uB300\uD558\uB294
        \uC0AC\uB78C\uC774 \uC788\uC5B4\uC694. \uADFC\uB370 \uC800 \uC548 \uADF8\uB9CC\uB46C\uC694."
    - context: "\uC57D\uC18D\uD55C \uAC8C \uC788\uC5B4\uC11C\uC694. \uADF8\uAC8C
        \uBB54\uC9C0\uB294 \uC544\uC9C1 \uB9D0 \uBABB \uD558\uACA0\uC5B4\uC694."
  - unlockLevel: 10
    dialogues:
    - context: "\uB3D9\uC0DD \uAFC8 \uC774\uB8E8\uB824\uACE0 \uC2DC\uC791\uD588\uB294\uB370...
        \uC5B4\uB290 \uC21C\uAC04\uBD80\uD130 \uC800\uB3C4 \uC88B\uC544\uD558\uACE0
        \uC788\uB354\uB77C\uACE0\uC694. \uC774 \uC77C."
    - context: "\uC810\uC7A5\uB2D8\uD55C\uD14C \uAE30\uB304 \uC801 \uC5C6\uB2E4\uACE0
        \uC0DD\uAC01\uD588\uB294\uB370, \uC5B4\uB290\uC0C8 \uADF8\uB7EC\uACE0 \uC788\uC5C8\uC5B4\uC694.
        \uC2EB\uC9C0 \uC54A\uC544\uC694."
    - context: "\uC800 \uC55E\uC73C\uB85C\uB3C4 \uBC14\uD150\uB354 \uD560 \uAC70\uC608\uC694.
        \uB3D9\uC0DD \uB54C\uBB38\uB9CC\uC740 \uC544\uB2C8\uC5D0\uC694. \uC81C\uAC00
        \uC6D0\uD574\uC11C\uC694."
