  m_Script: {fileID: 11500000, guid: 213ce22313033f64e83377bd5902ea1f, type: 3}
  m_Name: Cian
  m_EditorClassIdentifier: Assembly-CSharp::CharacterSO
  id: Cian
  characterName: Cian
  currentLevel: 1
  currentExp: 0
  maxLevel: 10
  characterPortrait: {fileID: 0}
  dialogueGroups:
  - unlockLevel: 1
    dialogues:
    - context: "\uBAA8\uB974\uB294 \uAC74 \uBB3C\uC5B4\uBCF4\uC138\uC694. \uD6A8\uC728\uC801\uC73C\uB85C
        \uD558\uB294 \uAC8C \uC11C\uB85C\uD55C\uD14C \uB0AB\uAC70\uB4E0\uC694."
    - context: "\uC190\uB2D8\uC740 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uC544\uC694."
    - context: "\uC77C\uC740\uC81C\uB300\uB85C \uD558\uBA74 \uB3FC\uC694. \uADF8\uAC8C
        \uC804\uBD80\uC608\uC694."
  - unlockLevel: 2
    dialogues:
    - context: "\uC0DD\uAC01\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uD30C\uC545\uD558\uB124\uC694."
    - context: "\uC65C \uADF8\uB807\uAC8C \uD55C \uAC70\uC608\uC694? \uBE44\uD6A8\uC728\uC801\uC774\uC5C8\uB294\uB370...
        \uC190\uB2D8\uC740 \uC88B\uC544\uD558\uB354\uB77C\uACE0\uC694."
    - context: "\uB2F9\uC2E0\uC740 \uC880 \uD2B9\uC774\uD558\uB124\uC694. \uB098\uC05C
        \uC758\uBBF8\uB294 \uC544\uB2C8\uC5D0\uC694."
  - unlockLevel: 4
    dialogues:
    - context: "\uC624\uB298 \uB9C8\uAC10 \uAC19\uC774 \uD574\uC918\uC11C... \uB3C4\uC6C0\uC774
        \uB410\uC5B4\uC694."
    - context: "\uB2F9\uC2E0 \uB9D0\uC774 \uB9DE\uC558\uC5B4\uC694. \uC778\uC815\uD558\uAE30
        \uC2EB\uC5C8\uC9C0\uB9CC."
    - context: "\uC774 \uBC14, \uB9DD\uD558\uAC8C \uB450\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC694.
        \uADF8\uAC74 \uC800\uB3C4\uC694."
  - unlockLevel: 6
    dialogues:
    - context: "\uB2F9\uC2E0\uC774 \uC5EC\uAE30 \uC5C6\uC5C8\uC73C\uBA74 \uC5B4\uB5BB\uAC8C
        \uB410\uC744\uAE4C, \uAC00\uB054 \uC0DD\uAC01\uD574\uC694."
    - context: "\uC190\uB2D8\uC774 \uB9DB\uC788\uB2E4\uACE0 \uD560 \uB54C... \uC800\uB3C4
        \uAE30\uBD84\uC774 \uC88B\uC544\uC694. \uD45C\uD604\uC744 \uBABB \uD560 \uBFD0\uC774\uC5D0\uC694."
    - context: "\uD2C0\uB9AC\uBA74 \uB9D0\uD574\uC918\uC694. \uB2F9\uC2E0 \uB9D0\uC740
        \uB4E4\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC73C\uB2C8\uAE4C."
  - unlockLevel: 8
    dialogues:
    - context: "\uC694\uC998 \uC77C \uB05D\uB098\uACE0\uB3C4 \uC5EC\uAE30 \uC0DD\uAC01\uC774
        \uB098\uC694..."
    - context: "\uAE30\uB300\uBA74 \uC548 \uB41C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB294\uB370,
        \uB2F9\uC2E0 \uC606\uC5D0\uC120 \uADF8\uAC8C \uC798 \uC548 \uB3FC\uC694."
    - context: "\uC624\uB298 \uC6C3\uC5C8\uC5B4\uC694. \uB2F9\uC2E0 \uB54C\uBB38\uC5D0\uC694.
        ...\uADF8\uAC83\uB9CC\uC694."
  - unlockLevel: 10
    dialogues:
    - context: "\uC774 \uBC14\uAC00 \uC88B\uC544\uC694. \uC77C\uC774 \uC544\uB2C8\uB77C,
        \uC5EC\uAE30 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC774\uC694."
    - context: "\uCC98\uC74C\uC73C\uB85C... \uADF8\uB0E5 \uC0AC\uB78C\uC73C\uB85C
        \uC788\uC5B4\uB3C4 \uB418\uACA0\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uC5B4\uC694.
        \uB2F9\uC2E0 \uC606\uC5D0\uC11C."
    - context: "\uC55E\uC73C\uB85C\uB3C4 \uC5EC\uAE30 \uC788\uC5B4\uC904 \uAC70\uC8E0?
        \uB300\uB2F5 \uC548 \uD574\uC918\uB3C4 \uB3FC\uC694."
