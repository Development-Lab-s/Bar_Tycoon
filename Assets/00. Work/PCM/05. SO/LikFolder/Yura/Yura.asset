MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 213ce22313033f64e83377bd5902ea1f, type: 3}
  m_Name: Yura
  m_EditorClassIdentifier: Assembly-CSharp::CharacterSO
  id: Yura
  characterName: Yura
  currentLevel: 1
  currentExp: 0
  maxLevel: 10
  characterPortrait: {fileID: 0}
  dialogueGroups:
  - unlockLevel: 1
    dialogues:
    - context: "\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694, \uC810\uC7A5\uB2D8! \uC5F4\uC2EC\uD788
        \uD560\uAC8C\uC694."
    - context: "\uBAA8\uB974\uB294 \uAC8C \uC788\uC73C\uBA74 \uC5EC\uCB64\uBD10\uB3C4
        \uB420\uAE4C\uC694?"
    - context: "\uC624\uB298\uB3C4 \uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!"
  - unlockLevel: 2
    dialogues:
    - context: "\uC810\uC7A5\uB2D8, \uBC29\uAE08 \uC81C\uAC00 \uCE75\uD14C\uC77C
        \uC774\uB984 \uD2C0\uB838\uC8E0? \uBABB \uB4E4\uC740 \uCC99 \uD574\uC8FC\uC2DC\uBA74
        \uC548 \uB420\uAE4C\uC694?"
    - context: "\uC544\uC9C1 \uBA54\uB274 \uB2E4 \uBABB \uC678\uC6E0\uB294\uB370...
        \uAE08\uBC29 \uD560\uAC8C\uC694, \uC9C4\uC9DC\uB85C\uC694!"
    - context: "\uC5EC\uAE30 \uBD84\uC704\uAE30 \uC88B\uC9C0 \uC54A\uC544\uC694?
        \uC800 \uCD9C\uADFC\uD558\uB294 \uAC8C \uC2EB\uC9C0 \uC54A\uC544\uC694."
  - unlockLevel: 4
    dialogues:
    - context: "\uC810\uC7A5\uB2D8\uC740 \uB2E8 \uAC70 \uC88B\uC544\uD558\uC138\uC694?
        \uC800\uB294 \uC5C4\uCCAD \uC88B\uC544\uD558\uAC70\uB4E0\uC694."
    - context: "\uC624\uB298 \uD301 \uBC1B\uC558\uC5B4\uC694! \uC870\uAE08\uC774\uC9C0\uB9CC...
        \uAE30\uBD84\uC774 \uB108\uBB34 \uC88B\uC544\uC694."
  - unlockLevel: 6
    dialogues:
    - context: "\uC0AC\uC2E4 \uC800, \uC5EC\uAE30\uC11C \uC77C\uD558\uB294 \uAC70
        \uC2A4\uC2A4\uB85C \uC815\uD55C \uAC70\uC608\uC694. \uCC98\uC74C\uC73C\uB85C\uC694."
    - context: "\uC810\uC7A5\uB2D8\uC740 \uC81C\uAC00 \uC2E4\uC218\uD574\uB3C4 \uC2E4\uB9DD\uD55C
        \uD45C\uC815 \uC548 \uC9D3\uB354\uB77C\uACE0\uC694. ...\uADF8\uAC8C \uC88B\uC544\uC694."
    - context: "\uB3C8 \uBAA8\uC73C\uBA74 \uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5B4\uC694.
        \uC544\uC9C1 \uB9D0\uD558\uAE30 \uBD80\uB044\uB7FD\uC9C0\uB9CC\uC694."
  - unlockLevel: 8
    dialogues:
    - context: "\uC810\uC7A5\uB2D8, \uC800 \uC0AC\uC2E4 \uD558\uACE0 \uC2F6\uC740
        \uAC8C \uB9CE\uC740 \uC0AC\uB78C\uC774\uC5D0\uC694. \uBAB0\uB790\uC8E0?"
    - context: "\uCC29\uD558\uAC8C\uB9CC \uC0B4\uBA74 \uB418\uB294 \uC904 \uC54C\uC558\uB294\uB370...
        \uADF8\uAC8C \uC804\uBD80\uB294 \uC544\uB2CC \uAC83 \uAC19\uC544\uC694."
    - context: "\uC81C\uAC00 \uC6D0\uD558\uB294 \uAC78 \uB9D0\uD574\uB3C4 \uB41C\uB2E4\uB294
        \uAC8C, \uC544\uC9C1\uB3C4 \uC5B4\uC0C9\uD574\uC694."
  - unlockLevel: 10
    dialogues:
    - context: "\uC810\uC7A5\uB2D8 \uB355\uBD84\uC5D0 \uCC98\uC74C\uC73C\uB85C \uC81C\uAC00
        \uC120\uD0DD\uD55C \uACF3\uC5D0\uC11C, \uC81C\uAC00 \uC6D0\uD574\uC11C \uC6C3\uC740
        \uAC83 \uAC19\uC544\uC694."
    - context: "\uD558\uACE0 \uC2F6\uC740 \uAC70 \uC0DD\uACBC\uC5B4\uC694. \uC544\uC9C1
        \uC791\uC740 \uAC70\uC9C0\uB9CC... \uCC98\uC74C\uC774\uC5D0\uC694, \uC774\uB7F0
        \uB290\uB08C."
    - context: "\uC800 \uAF64 \uC798 \uD558\uACE0 \uC788\uC8E0? \uCE6D\uCC2C\uD574\uC918\uB3C4
        \uB3FC\uC694."
